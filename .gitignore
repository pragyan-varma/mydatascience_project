# Python
__pycache__/
*.pyc
venv/
.venv/
.ipynb_checkpoints/

# Data (raw datasets usually shouldn't go in git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained models (regenerated by training script)
models/*.pkl
!models/.gitkeep

# Secrets / scratch files (never commit)
tmp/

